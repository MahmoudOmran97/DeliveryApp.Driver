<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DeliveryApp.Driver.ViewModels"
             xmlns:m="clr-namespace:DeliveryApp.Driver.Models"
             xmlns:controls="clr-namespace:DeliveryApp.Driver.Controls"
             xmlns:loc="clr-namespace:DeliveryApp.Driver.Converters"
             x:Class="DeliveryApp.Driver.Views.AvailableOrdersPage"
             x:DataType="vm:AvailableOrdersViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#F8F9FA">

	<Grid RowDefinitions="Auto,Auto,*,Auto">

		<!-- Header -->
        <Grid RowDefinitions="Auto,*">

            <!-- Header (no back button — this is a Tab now) -->
            <Grid Grid.Row="0" BackgroundColor="#FF5722"
           Padding="20,52,20,16"
           ColumnDefinitions="*,Auto">
                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
					<Label Text="{loc:Loc Key=AvailableOrders}" FontFamily="CairoBold" FontSize="22" TextColor="White"/>
					<Label Text="{Binding OrdersCount}"
						   FontFamily="CairoRegular" FontSize="13" TextColor="#FFCCBC"/>
				</VerticalStackLayout>
                <Border Grid.Column="1" Padding="10,6"
         StrokeShape="RoundRectangle 12"
         Stroke="#FFCCBC" StrokeThickness="1"
         BackgroundColor="#33FFFFFF"
         VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding LoadCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="{loc:Loc Key=Refresh}" FontFamily="CairoBold" FontSize="13"
            TextColor="White" VerticalOptions="Center"/>
                </Border>
               
			</Grid>
		</Grid>

		<!-- ✅ Filter Bar — ثابت فوق (مش جوه الـ CollectionView) فيفضل ظاهر حتى لو الدريفر عمل سكرول -->
		<VerticalStackLayout Grid.Row="1" BackgroundColor="White" Padding="0,10,0,8" Spacing="8">

			<!-- شرائح النطاق: الكل / جوه النطاق / برّه النطاق -->
			<CollectionView ItemsSource="{Binding RangeFilters}" HeightRequest="38" Margin="12,0,0,0">
				<CollectionView.ItemsLayout>
					<LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/>
				</CollectionView.ItemsLayout>
				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="vm:FilterChipItem">
						<Border Padding="14,0" HeightRequest="34" StrokeShape="RoundRectangle 17" Stroke="Transparent"
                                BackgroundColor="{Binding IsSelected, Converter={StaticResource RangeChipBgConverter}}">
							<Border.GestureRecognizers>
								<TapGestureRecognizer
									Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AvailableOrdersViewModel}}, Path=SelectRangeFilterCommand}"
									CommandParameter="{Binding .}"/>
							</Border.GestureRecognizers>
							<Label Text="{Binding Label}" FontFamily="CairoBold" FontSize="12"
                                   TextColor="{Binding IsSelected, Converter={StaticResource ChipTextColorConverter}}"
                                   VerticalOptions="Center" HorizontalOptions="Center"/>
						</Border>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>

			<!-- شرائح المنطقة: الكل + منطقة لكل مجموعة محلات (مستنتجة من الإحداثيات) فيها طلبات دلوقتي -->
			<CollectionView ItemsSource="{Binding ZoneFilters}" HeightRequest="34" Margin="12,0,0,0">
				<CollectionView.ItemsLayout>
					<LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/>
				</CollectionView.ItemsLayout>
				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="vm:FilterChipItem">
						<Border Padding="12,0" HeightRequest="30" StrokeShape="RoundRectangle 15" Stroke="Transparent"
                                BackgroundColor="{Binding IsSelected, Converter={StaticResource ZoneChipBgConverter}}">
							<Border.GestureRecognizers>
								<TapGestureRecognizer
									Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AvailableOrdersViewModel}}, Path=SelectZoneFilterCommand}"
									CommandParameter="{Binding .}"/>
							</Border.GestureRecognizers>
							<Label Text="{Binding Label}" FontFamily="CairoRegular" FontSize="11"
                                   TextColor="{Binding IsSelected, Converter={StaticResource ChipTextColorConverter}}"
                                   VerticalOptions="Center" HorizontalOptions="Center"/>
						</Border>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>

			<BoxView HeightRequest="1" Color="#F0F0F0" Margin="0,2,0,0"/>
		</VerticalStackLayout>

		<!-- Orders List -->
		<RefreshView Grid.Row="2"
                     Command="{Binding LoadCommand}"
                     IsRefreshing="{Binding IsRefreshing}">
			<CollectionView ItemsSource="{Binding Orders}"
                            EmptyView="{Binding EmptyMessage}"
                            Margin="0,8">
				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="m:AvailableOrder">
						<Border Margin="16,6" BackgroundColor="White"
                                StrokeShape="RoundRectangle 16" Stroke="Transparent"
                                Shadow="{Shadow Brush=Black, Offset='0,2', Radius=8, Opacity=0.08}"
                                Padding="16">
							<Border.GestureRecognizers>
								<TapGestureRecognizer
									Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AvailableOrdersViewModel}}, Path=OpenDetailsCommand}"
									CommandParameter="{Binding .}"/>
							</Border.GestureRecognizers>
							<VerticalStackLayout Spacing="12">

								<!-- Top: Restaurant + Time -->
								<Grid ColumnDefinitions="*,Auto">
									<VerticalStackLayout Grid.Column="0" Spacing="6">
										<HorizontalStackLayout Spacing="6">
											<Border BackgroundColor="#FFF3EE" Stroke="#FFD9CC" StrokeShape="RoundRectangle 8"
											        Padding="8,2" HorizontalOptions="Start">
												<Label Text="{Binding Id, StringFormat='#{0}'}"
												       FontFamily="CairoBold" FontSize="12" TextColor="#FF5722"/>
											</Border>
											<Border BackgroundColor="#F0F6FF" Stroke="#D8E9FF" StrokeShape="RoundRectangle 8"
											        Padding="8,2" HorizontalOptions="Start"
											        IsVisible="{Binding ZoneName, Converter={StaticResource StringNotEmpty}}">
												<Label Text="{Binding ZoneName}"
												       FontFamily="CairoRegular" FontSize="11" TextColor="#1976D2"/>
											</Border>
										</HorizontalStackLayout>
										<HorizontalStackLayout Spacing="8">
										<Label Text="🏪" FontSize="18" VerticalOptions="Center"/>
										<Label Text="{Binding RestaurantName}"
                                               FontFamily="CairoBold" FontSize="15" TextColor="#212121"
                                               VerticalOptions="Center"/>
									</HorizontalStackLayout>
									</VerticalStackLayout>
									<Label Grid.Column="1" Text="{Binding TimeAgoText}"
                                           FontFamily="CairoRegular" FontSize="12" TextColor="#9E9E9E"
                                           VerticalOptions="Center"/>
								</Grid>

								<!-- Divider -->
								<BoxView HeightRequest="1" Color="#F5F5F5"/>

								<!-- Delivery Address -->
								<HorizontalStackLayout Spacing="8">
									<Label Text="📍" FontSize="14" VerticalOptions="Start"/>
									<Label Text="{Binding DeliveryAddress}"
                                           FontFamily="CairoRegular" FontSize="13" TextColor="#616161"
                                           LineBreakMode="WordWrap" HorizontalOptions="FillAndExpand"/>
								</HorizontalStackLayout>

									<!-- Status, distance, and preparation time -->
									<Grid ColumnDefinitions="*,*,*" Margin="0,0,0,2">
										<VerticalStackLayout Grid.Column="0" Spacing="2"><Label Text="{loc:Loc Key=OrderStatus}" FontFamily="CairoRegular" FontSize="11" TextColor="#9E9E9E"/><Label Text="{Binding StatusText}" FontFamily="CairoBold" FontSize="13" TextColor="#FF5722"/></VerticalStackLayout>
										<VerticalStackLayout Grid.Column="1" Spacing="2"><Label Text="{loc:Loc Key=Distance}" FontFamily="CairoRegular" FontSize="11" TextColor="#9E9E9E"/><Label Text="{Binding DistanceText}" FontFamily="CairoBold" FontSize="14" TextColor="{Binding CanAccept, Converter={StaticResource CanAcceptToTextColorConverter}}"/></VerticalStackLayout>
										<VerticalStackLayout Grid.Column="2" Spacing="2"><Label Text="{loc:Loc Key=PreparationTime}" FontFamily="CairoRegular" FontSize="11" TextColor="#9E9E9E"/><Label Text="{Binding PreparationTimeText}" FontFamily="CairoBold" FontSize="14" TextColor="#212121"/></VerticalStackLayout>
									</Grid>

									<!-- Stats Row -->
									<Grid ColumnDefinitions="*,*,*">
									<VerticalStackLayout Grid.Column="0" Spacing="2">
										<Label Text="{loc:Loc Key=OrderEarning}" FontFamily="CairoRegular" FontSize="11" TextColor="#9E9E9E"/>
										<Label Text="{Binding DeliveryFeeText}"
                                               FontFamily="CairoBold" FontSize="16" TextColor="#4CAF50"/>
									</VerticalStackLayout>
									<VerticalStackLayout Grid.Column="1" Spacing="2">
										<Label Text="{loc:Loc Key=OrderTotal}" FontFamily="CairoRegular" FontSize="11" TextColor="#9E9E9E"/>
										<Label Text="{Binding TotalAmountText}"
                                               FontFamily="CairoBold" FontSize="15" TextColor="#212121"/>
									</VerticalStackLayout>
									<VerticalStackLayout Grid.Column="2" Spacing="2">
										<Label Text="{loc:Loc Key=ItemsCount}" FontFamily="CairoRegular" FontSize="11" TextColor="#9E9E9E"/>
										<Label Text="{Binding ItemCountText}"
                                               FontFamily="CairoBold" FontSize="15" TextColor="#212121"/>
									</VerticalStackLayout>
								</Grid>

								<!-- Accept Button (out-of-range orders stay visible in the list but the button greys out and disables) -->
								<Button Text="{Binding AcceptButtonText}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="{Binding CanAccept, Converter={StaticResource BoolToColorConverter}}"
                                        TextColor="White"
                                        IsEnabled="{Binding CanAccept}"
                                        FontFamily="CairoBold" FontSize="14"
                                        HeightRequest="44" CornerRadius="10"
                                        Clicked="OnAcceptClicked"/>

							</VerticalStackLayout>
						</Border>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>
		</RefreshView>

		<!-- Busy overlay -->
		<Grid Grid.Row="2" IsVisible="{Binding IsBusy}"
              BackgroundColor="#80FFFFFF">
			<ActivityIndicator IsRunning="True" Color="#FF5722"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
		</Grid>

		<controls:CurvedBottomBar Grid.Row="3" SelectedTab="orders"
                                 HorizontalOptions="Fill" Margin="0" Padding="0"/>
	</Grid>
</ContentPage>
