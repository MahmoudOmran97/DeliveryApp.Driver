<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DeliveryApp.Driver.ViewModels"
             xmlns:m="clr-namespace:DeliveryApp.Driver.Models"
             xmlns:loc="clr-namespace:DeliveryApp.Driver.Converters"
             x:Class="DeliveryApp.Driver.Views.DuesPage"
             x:DataType="vm:DuesViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             FlowDirection="{Binding Source={StaticResource LocStrings}, Path=Flow}"
             BackgroundColor="#F8F9FA">

	<Grid RowDefinitions="Auto,*">

		<!-- ── Header with back button ── -->
		<Grid Grid.Row="0" BackgroundColor="#FF5722"
              Padding="20,52,20,20"
              ColumnDefinitions="44,*,Auto">

			<Image Grid.Column="0"
                   Source="icon_back.png"
                   WidthRequest="38" HeightRequest="38"
                   VerticalOptions="Center">
				<Image.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding GoBackCommand}"/>
				</Image.GestureRecognizers>
			</Image>

			<VerticalStackLayout Grid.Column="1" Spacing="2"
                                 Margin="12,0,0,0" VerticalOptions="Center">
				<Label Text="{loc:Loc Key=MyDues}"
                       FontFamily="CairoBold" FontSize="22" TextColor="White"/>
				<Label Text="{loc:Loc Key=DuesToPlatform}"
                       FontFamily="CairoRegular" FontSize="13" TextColor="#FFCCBC"/>
			</VerticalStackLayout>

			<Button Grid.Column="2"
                    Text="↻"
                    Command="{Binding LoadCommand}"
                    BackgroundColor="Transparent" TextColor="White"
                    FontFamily="CairoBold" FontSize="18"/>
		</Grid>

		<RefreshView Grid.Row="1"
                     Command="{Binding LoadCommand}"
                     IsRefreshing="{Binding IsRefreshing}">
			<ScrollView>
				<VerticalStackLayout Spacing="0">

					<!-- ── PENDING SUMMARY CARD ── -->
					<Border Margin="16,-20,16,0" BackgroundColor="White"
                            StrokeShape="RoundRectangle 16" Stroke="Transparent"
                            Shadow="{Shadow Brush=Black, Offset='0,2', Radius=8, Opacity=0.08}"
                            Padding="20,18">
						<VerticalStackLayout Spacing="6" HorizontalOptions="Center">
							<Label Text="{Binding Summary.PendingAmountText}"
                                   FontFamily="CairoBold" FontSize="30"
                                   TextColor="#F44336"
                                   HorizontalOptions="Center"
                                   IsVisible="{Binding Summary.HasPending}"/>
							<Label Text="{loc:Loc Key=PendingDues}"
                                   FontFamily="CairoRegular" FontSize="13"
                                   TextColor="#757575" HorizontalOptions="Center"
                                   IsVisible="{Binding Summary.HasPending}"/>

							<Border BackgroundColor="#FFF3E0" Stroke="Transparent"
                                    StrokeShape="RoundRectangle 10" Padding="12,6"
                                    Margin="0,8,0,0"
                                    IsVisible="{Binding Summary.HasPending}">
								<Label Text="{loc:Loc Key=DuesReminder}"
                                       FontFamily="CairoRegular" FontSize="12"
                                       TextColor="#E65100" HorizontalOptions="Center"/>
							</Border>

							<Label Text="✅" FontSize="30" HorizontalOptions="Center"
                                   IsVisible="{Binding Summary.HasPending, Converter={StaticResource InvertedBool}}"/>
							<Label Text="{loc:Loc Key=DuesAllSettled}"
                                   FontFamily="CairoBold" FontSize="14"
                                   TextColor="#4CAF50" HorizontalOptions="Center"
                                   Margin="0,4,0,0"
                                   IsVisible="{Binding Summary.HasPending, Converter={StaticResource InvertedBool}}"/>
						</VerticalStackLayout>
					</Border>

					<VerticalStackLayout Padding="16,20,16,0" Spacing="14">

						<Label Text="{loc:Loc Key=DuesHistory}"
                               FontFamily="CairoBold" FontSize="16" TextColor="#212121"/>

						<CollectionView ItemsSource="{Binding Dues}"
                                        EmptyView="{loc:Loc Key=NoDuesYet}">
							<CollectionView.ItemTemplate>
								<DataTemplate x:DataType="m:DriverDue">
									<Border Margin="0,0,0,10" BackgroundColor="White"
                                            StrokeShape="RoundRectangle 14" Stroke="Transparent"
                                            Shadow="{Shadow Brush=Black, Offset='0,2', Radius=6, Opacity=0.06}"
                                            Padding="16,14">
										<VerticalStackLayout Spacing="10">

											<Grid ColumnDefinitions="*,Auto">
												<Label Text="{Binding PeriodText}" Grid.Column="0"
                                                       FontFamily="CairoBold" FontSize="14" TextColor="#212121"
                                                       VerticalOptions="Center"/>
												<Border Grid.Column="1" BackgroundColor="{Binding StatusColorHex}"
                                                        Stroke="Transparent" StrokeShape="RoundRectangle 8"
                                                        Padding="10,4">
													<Label Text="{Binding StatusText}"
                                                           FontFamily="CairoBold" FontSize="11" TextColor="White"/>
												</Border>
											</Grid>

											<Grid ColumnDefinitions="*,*,*">
												<VerticalStackLayout Grid.Column="0" Spacing="2">
													<Label Text="{loc:Loc Key=OrdersCount}" FontFamily="CairoRegular" FontSize="11" TextColor="#9E9E9E"/>
													<Label Text="{Binding OrdersCount}" FontFamily="CairoBold" FontSize="14" TextColor="#212121"/>
												</VerticalStackLayout>
												<VerticalStackLayout Grid.Column="1" Spacing="2">
													<Label Text="{loc:Loc Key=AmountDue}" FontFamily="CairoRegular" FontSize="11" TextColor="#9E9E9E"/>
													<Label Text="{Binding AmountDueText}" FontFamily="CairoBold" FontSize="14" TextColor="#F44336"/>
												</VerticalStackLayout>
												<VerticalStackLayout Grid.Column="2" Spacing="2">
													<Label Text="{loc:Loc Key=AmountRemaining}" FontFamily="CairoRegular" FontSize="11" TextColor="#9E9E9E"/>
													<Label Text="{Binding AmountRemainingText}" FontFamily="CairoBold" FontSize="14" TextColor="#FF9800"/>
												</VerticalStackLayout>
											</Grid>

											<Label Text="{Binding Notes}"
                                                   FontFamily="CairoRegular" FontSize="12" TextColor="#757575"
                                                   IsVisible="{Binding Notes, Converter={StaticResource StringNotEmpty}}"/>
										</VerticalStackLayout>
									</Border>
								</DataTemplate>
							</CollectionView.ItemTemplate>
						</CollectionView>

						<BoxView HeightRequest="20" Color="Transparent"/>

					</VerticalStackLayout>
				</VerticalStackLayout>
			</ScrollView>
		</RefreshView>

	</Grid>
</ContentPage>
