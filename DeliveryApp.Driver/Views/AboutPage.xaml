<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DeliveryApp.Driver.ViewModels"
             xmlns:loc="clr-namespace:DeliveryApp.Driver.Converters"
             x:Class="DeliveryApp.Driver.Views.AboutPage"
             x:DataType="vm:AboutViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" BackgroundColor="#FF5722" Padding="16,48,16,16" ColumnDefinitions="44,*">
            <ImageButton Grid.Column="0" Source="icon_back.png" WidthRequest="38" HeightRequest="38"
                         BackgroundColor="Transparent" Command="{Binding GoBackCommand}"/>
            <Label Grid.Column="1" Text="{loc:Loc Key=AboutApp}" FontFamily="CairoBold" FontSize="22"
                   TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,0,44,0"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,24,20,32" Spacing="20">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Border BackgroundColor="#FF5722" StrokeShape="RoundRectangle 26" WidthRequest="104" HeightRequest="104" Padding="14">
                        <Image Source="logo_en.png" Aspect="AspectFit"/>
                    </Border>
                    <Label Text="{loc:Loc Key=AppName}" FontFamily="CairoBold" FontSize="25" TextColor="#FF5722" HorizontalOptions="Center"/>
                    <Label Text="{loc:Loc Key=AboutVersion}" FontFamily="CairoRegular" FontSize="14" TextColor="#757575" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <Border BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="18">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{loc:Loc Key=AboutDescriptionTitle}" FontFamily="CairoBold" FontSize="17" TextColor="#212121"/>
                        <Label Text="{loc:Loc Key=AboutDescription}" FontFamily="CairoRegular" FontSize="14" TextColor="#616161" LineHeight="1.4"/>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="18">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{loc:Loc Key=AboutFeatures}" FontFamily="CairoBold" FontSize="17" TextColor="#212121"/>
                        <Label Text="•  {loc:Loc Key=AboutFeature1}" FontFamily="CairoRegular" FontSize="14" TextColor="#616161"/>
                        <BoxView HeightRequest="1" Color="#EEEEEE"/>
                        <Label Text="•  {loc:Loc Key=AboutFeature2}" FontFamily="CairoRegular" FontSize="14" TextColor="#616161"/>
                        <BoxView HeightRequest="1" Color="#EEEEEE"/>
                        <Label Text="•  {loc:Loc Key=AboutFeature3}" FontFamily="CairoRegular" FontSize="14" TextColor="#616161"/>
                        <BoxView HeightRequest="1" Color="#EEEEEE"/>
                        <Label Text="•  {loc:Loc Key=AboutFeature4}" FontFamily="CairoRegular" FontSize="14" TextColor="#616161"/>
                    </VerticalStackLayout>
                </Border>

                <Label Text="{loc:Loc Key=AboutCopyright}" FontFamily="CairoRegular" FontSize="12" TextColor="#BDBDBD" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
